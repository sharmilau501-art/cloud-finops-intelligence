# Isolated Docker development runtime: Airflow 3 and FinOps tools use separate environments.
# Pin the Airflow image for reproducible local builds.
FROM apache/airflow:3.1.7-python3.12
USER root
RUN python -m venv /opt/finops_venv \
    && /opt/finops_venv/bin/python -m pip install --no-cache-dir --upgrade pip \
    && /opt/finops_venv/bin/python -m pip install --no-cache-dir \
       'pandas>=2.2,<3.0' 'duckdb>=1.1,<2.0' 'dbt-duckdb>=1.9,<2.0'
USER airflow
